# TapCanvas Web Environment Configuration
# Generated for HTTPS deployment

# Backend API
VITE_API_BASE="https://api.aiplantform.site"

# Object Storage (required)
VITE_OBJECT_STORAGE_PROVIDER="r2"
VITE_TOS_PUBLIC_BASE_URL="https://tanvas-ai.tos-cn-guangzhou.volces.com"
VITE_R2_PUBLIC_BASE_URL="https://assets.tapcanvas.uk"

# GitHub OAuth
VITE_GITHUB_CLIENT_ID="YOUR_GITHUB_CLIENT_ID"
VITE_GITHUB_REDIRECT_URI="https://canvas.aiplantform.site/oauth/github"

# WebCut (optional)
VITE_WEBCUT_URL="http://localhost:5174"
